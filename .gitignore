# ProxiLink .gitignore
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets (Keep .env.example tracked)
.env
.env.local
.env.*.local

# Database Binaries
backend/database/*.db
backend/database/*.db-journal
database/*.db

# Uploads directory (keep directory tracked with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# SSL / TLS Private Keys and Certificates
ssl/*.key
ssl/*.crt
ssl/*.pem
certs/*.key
certs/*.pem

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
